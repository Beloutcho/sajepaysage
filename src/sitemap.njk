---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
{%- set site = contenu.site -%}
{%- macro url(cle, slug) -%}
  <url>
    <loc>{{ cle | lien("fr", slug) | absolu(site) }}</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ cle | lien('fr', slug) | absolu(site) }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ cle | lien('en', slug) | absolu(site) }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ cle | lien('fr', slug) | absolu(site) }}"/>
  </url>
  <url>
    <loc>{{ cle | lien("en", slug) | absolu(site) }}</loc>
    <xhtml:link rel="alternate" hreflang="fr" href="{{ cle | lien('fr', slug) | absolu(site) }}"/>
    <xhtml:link rel="alternate" hreflang="en" href="{{ cle | lien('en', slug) | absolu(site) }}"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="{{ cle | lien('fr', slug) | absolu(site) }}"/>
  </url>
{%- endmacro -%}
<?xml version="1.0" encoding="utf-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
{%- for cle in ["accueil", "demarche", "projets", "missions", "contact", "mentions"] %}
{{ url(cle) }}
{%- endfor %}
{%- for p in contenu.projetsPublies %}
{{ url("projet", p.slug) }}
{%- endfor %}
{%- for m in contenu.missions %}
{{ url("mission", m.slug) }}
{%- endfor %}
</urlset>
